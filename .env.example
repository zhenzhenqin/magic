# 后端从仓库根目录的 .env 或进程环境读取配置。
APP_ENV=development
APP_ORIGINS=["http://127.0.0.1:5173"]
DATABASE_URL=sqlite:///data/fooddiary.db
# 本机启动脚本可为未配置 .env 的开发环境生成 D 盘专用密钥。
# 复制此文件为 .env 时，须自行填写安全随机密钥。
JWT_SECRET=
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_SECONDS=2592000
REFRESH_COLLISION_SECONDS=10
LOGIN_ATTEMPTS=10
REGISTER_ATTEMPTS=8
REFRESH_ATTEMPTS=60
LIMIT_WINDOW_SECONDS=60
ARGON_MEMORY_KIB=32768
ARGON_TIME_COST=2
ARGON_SLOTS=2

# 后续 MySQL 部署候选，阶段 2 未接入。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=fooddiary
MYSQL_USER=fooddiary
MYSQL_PASSWORD=

MEDIA_STORAGE_BACKEND=local
MEDIA_LOCAL_ROOT=./data/media

# AI 配置仅供服务端使用，以后按所选供应商填写。
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
