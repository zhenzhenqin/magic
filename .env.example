# 示例参数。各模块会在对应阶段定义配置校验与加载方式。
APP_ENV=development
APP_ORIGIN=http://localhost:5173

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=fooddiary
MYSQL_USER=fooddiary
MYSQL_PASSWORD=

MEDIA_STORAGE_BACKEND=local
MEDIA_LOCAL_ROOT=./data/media

# AI 配置仅供服务端使用，以后按所选供应商填写。
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
