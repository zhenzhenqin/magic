# 后端从仓库根目录的 .env 或进程环境读取配置。
APP_ENV=development
APP_ORIGINS=["http://127.0.0.1:5173"]
DATABASE_URL=sqlite:///data/fooddiary.db
# 本机启动脚本可为未配置 .env 的开发环境生成 D 盘专用密钥。
# 复制此文件为 .env 时，须自行填写安全随机密钥。
JWT_SECRET=
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_SECONDS=2592000
REFRESH_COLLISION_SECONDS=10
LOGIN_ATTEMPTS=10
REGISTER_ATTEMPTS=8
REFRESH_ATTEMPTS=60
# 开发默认开放，生产默认关闭。生产内测用本机账号创建命令。
# PUBLIC_REGISTRATION=false
# REGISTRATION_MODE=closed
EMAIL_MODE=disabled
EMAIL_CODE_SECRET=
EMAIL_DAILY_LIMIT=100
SMTP_HOST=
SMTP_PORT=465
SMTP_SENDER=
SMTP_USERNAME=
SMTP_AUTHORIZATION_CODE=
LIMIT_WINDOW_SECONDS=60
FRIEND_LOOKUP_ATTEMPTS=12
FRIEND_REQUEST_ATTEMPTS=6
ARGON_MEMORY_KIB=32768
ARGON_TIME_COST=2
ARGON_SLOTS=2

# 开发机相对路径以 backend 为根。照片不会经公开静态路由提供。
MEDIA_DIR=data/media
IMAGE_UPLOAD_BYTES=10485760
IMAGE_MAX_PIXELS=20000000
IMAGE_MAX_EDGE=1600
IMAGE_THUMBNAIL_EDGE=400
IMAGE_PROCESS_SLOTS=1
MEDIA_UPLOAD_ATTEMPTS=30
MEDIA_USER_BYTES=209715200
MEDIA_USER_FILES=1000
MEDIA_ORPHAN_SECONDS=86400

# 后续 MySQL 部署候选，阶段 2 未接入。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=fooddiary
MYSQL_USER=fooddiary
MYSQL_PASSWORD=

# 阶段 7.3 的个人 AI 只开放本地模拟。模拟时显式启用 fake。
AI_ENABLED=false
AI_PROVIDER=qwen
AI_BASE_URL=
AI_BYOK_SIMULATION=false
AI_TEMPORARY_SECONDS=3600
AI_MODEL=qwen3-vl-flash
AI_TIMEOUT_SECONDS=40
AI_MAX_OUTPUT_TOKENS=3000
AI_MAX_IMAGES=3
AI_IMAGE_EDGE=1024
AI_MAX_CONCURRENT_JOBS=1
AI_USER_DAILY_LIMIT=10
AI_GLOBAL_DAILY_LIMIT=30
# 两家供应商的历史累计随账本保留，当前真实调用关闭。
AI_QWEN_CUMULATIVE_LIMIT=0
AI_DEEPSEEK_CUMULATIVE_LIMIT=0
AI_MAX_ATTEMPTS=3
AI_JOB_TTL_SECONDS=900
AI_JOB_RETENTION_SECONDS=604800

# Local CPU stickers work independently of external recognition.
STICKER_ENABLED=false
STICKER_PROVIDER=onnx
STICKER_MODEL_DIR=data/models/rembg
STICKER_EDGE=768
STICKER_THREADS=1
STICKER_TIMEOUT_SECONDS=25
# 原图上传和贴纸 Worker 使用同一全局图片磁盘保留线。
STICKER_MIN_FREE_BYTES=536870912
STICKER_PENDING_PER_USER=12
