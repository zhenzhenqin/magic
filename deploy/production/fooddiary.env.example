# Install as /opt/fooddiary/shared/config/fooddiary.env, mode root:fooddiary 0640.
APP_ENV=production
APP_ORIGINS='["https://food.example"]'
JWT_SECRET=
DATABASE_URL=sqlite:////opt/fooddiary/shared/data/fooddiary.db
MEDIA_DIR=/opt/fooddiary/shared/media
PUBLIC_REGISTRATION=false
REGISTER_ATTEMPTS=8
LOGIN_ATTEMPTS=10
REFRESH_ATTEMPTS=60
LIMIT_WINDOW_SECONDS=60
FRIEND_LOOKUP_ATTEMPTS=12
FRIEND_REQUEST_ATTEMPTS=6
MEDIA_UPLOAD_ATTEMPTS=30
IMAGE_UPLOAD_BYTES=10485760
IMAGE_MAX_EDGE=1600
IMAGE_MAX_PIXELS=20000000
IMAGE_PROCESS_SLOTS=1
MEDIA_USER_BYTES=209715200
MEDIA_USER_FILES=1000
STICKER_ENABLED=false
STICKER_PROVIDER=onnx
STICKER_MODEL_DIR=/opt/fooddiary/shared/models
STICKER_EDGE=768
STICKER_THREADS=1
STICKER_MIN_FREE_BYTES=536870912
AI_ENABLED=false
AI_QWEN_CUMULATIVE_LIMIT=0
AI_DEEPSEEK_CUMULATIVE_LIMIT=0
